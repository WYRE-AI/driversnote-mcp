{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.WYRE-AI/driversnote-mcp",
  "title": "Driversnote",
  "description": "MCP server for the Driversnote Public API.",
  "repository": {
    "url": "https://github.com/WYRE-AI/driversnote-mcp",
    "source": "github"
  },
  "version": "0.0.0",
  "websiteUrl": "https://github.com/WYRE-AI/driversnote-mcp",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/wyre-ai/driversnote-mcp:0.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DRIVERSNOTE_API_KEY",
          "description": "Driversnote API key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
