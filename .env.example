# Driversnote MCP server configuration. Copy to .env and fill in locally.
# Never commit real values. Store the API key in 1Password (or Key Vault).

# Driversnote API key: create one at https://www.driversnote.com/app/api-keys
# (team reports need a key whose owner is a team admin or manager).
DRIVERSNOTE_API_KEY=

# Optional. Must be https://*.driversnote.com (or localhost for tests).
# DRIVERSNOTE_API_URL=https://api.driversnote.com/v1/driversnote

# Comma-separated tiers to expose: read, write, admin. Default: read.
# DRIVERSNOTE_TOOL_TIERS=read

# Transport: stdio (default) or http.
# MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# AUTH_MODE=gateway reads the key from the X-Driversnote-Api-Key header
# (set by the Conduit gateway) and requires a signed S2S token.
# AUTH_MODE=env
# CONDUIT_S2S_SECRET=

# LOG_LEVEL=info
