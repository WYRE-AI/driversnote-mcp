# Driversnote MCP server configuration. Copy to .env and fill in locally.
# Never commit real values. Store the API key in 1Password (or Key Vault).

# Driversnote API key: create one at https://www.driversnote.com/app/api-keys
# (team reports need a key whose owner is a team admin or manager).
DRIVERSNOTE_API_KEY=

# Optional. Must be https://*.driversnote.com (or localhost for tests).
# DRIVERSNOTE_API_URL=https://api.driversnote.com/v1/driversnote

# Maximum API response bytes: default 16 MiB, ceiling 128 MiB. Invalid/non-positive values use the default.
# DRIVERSNOTE_MAX_UPSTREAM_BYTES=16777216

# Comma-separated tiers to expose: read, write, admin. Default: read.
# DRIVERSNOTE_TOOL_TIERS=read

# Transport: stdio (default) or http.
# MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080
# When set (even empty), enforce localhost/127.0.0.1/[::1] plus these Host names (no scheme/port).
# When unset, only effective loopback binds (including insecure dev) are Host-checked.
# Non-loopback binds with a real S2S secret rely on S2S HMAC; /health and /healthz are always exempt.
# HTTP POST bodies have a fixed 1 MiB limit.
# MCP_ALLOWED_HOSTS=mcp.example.com

# AUTH_MODE=gateway reads the key from the X-Driversnote-Api-Key header
# (set by the Conduit gateway) and requires a signed S2S token.
# AUTH_MODE=env
# At least 32 characters after trimming; generate with openssl rand -hex 32.
# CONDUIT_S2S_SECRET=

# LOG_LEVEL=info
